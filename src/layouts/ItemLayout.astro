---
import Layout from "./Layout.astro";

interface Props {
    title: string;
    description?: string;
    eyebrow: string;
    mod: string;
    tone?: string;
    typeLabel: string;
}

const { title, description, eyebrow, mod, tone = "tone-burgundy", typeLabel } = Astro.props;
---

<Layout title={`${title} | ModWiki`} description={description}>
    <main class="page-shell">
        <section class:list={["page-card", "entry-hero", tone]}>
            <div class="entry-hero__content">
                <p class="eyebrow">{eyebrow}</p>
                <h1>{title}</h1>
                {description && <p class="summary">{description}</p>}
            </div>

            <aside class="entry-hero__meta">
                <div class:list={["stat-card", tone]}>
                    <span class="stat-card__label">Mod</span>
                    <strong>{mod}</strong>
                </div>
                <div class:list={["stat-card", tone]}>
                    <span class="stat-card__label">Type</span>
                    <strong>{typeLabel}</strong>
                </div>
                <a class:list={["entry-link", "entry-link--compact", tone]} href={`/${mod}/`}>
                    <span>Back to mod</span>
                    <span class="entry-link__hint">Open</span>
                </a>
            </aside>
        </section>

        <section class:list={["page-card", "content-card", tone]}>
            <slot />
        </section>
    </main>
</Layout>
