---
import "../styles/global.css";
import { withBaseUrl } from "../utils/url.js";

const {
    title = "ModWiki",
    description = "Mod documentation and wiki pages.",
    themeStyle,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/u, "");
const isReportPage = currentPath.endsWith("/report");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBaseUrl("/favicon.svg")} />
		<link rel="icon" href={withBaseUrl("/favicon.ico")} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body style={themeStyle}>
		<div class="app-shell">
			<header class="site-header">
				<nav class="site-nav" aria-label="Main navigation">
					<a class="site-nav__brand" href={withBaseUrl("/")}>ModWiki</a>
					{!isReportPage && <a class="site-nav__report" href={withBaseUrl("/report")}>Report bug</a>}
				</nav>
			</header>
			<slot />
		</div>
	</body>
</html>
