---
import "../styles/global.css";
import { withBaseUrl } from "../utils/url.js";

const {
    title = "ModWiki",
    description = "Mod documentation and wiki pages.",
    themeStyle,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBaseUrl("/favicon.svg")} />
		<link rel="icon" href={withBaseUrl("/favicon.ico")} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body style={themeStyle}>
		<div class="app-shell">
			<slot />
		</div>
	</body>
</html>
