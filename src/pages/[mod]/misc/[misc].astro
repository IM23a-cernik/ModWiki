---
import { getCollection, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";

export async function getStaticPaths() {
    const miscEntries = await getCollection("misc");

    return miscEntries
        .map((misc) => {
            const [mod, section, miscSlug] = misc.id.split("/");

            if (!mod || section !== "misc" || !miscSlug) {
                return null;
            }

            return {
                params: { mod, misc: miscSlug },
                props: { misc },
            };
        })
        .filter(Boolean);
}

const { misc } = Astro.props;
const { Content } = await render(misc);
---

<ItemLayout
    title={misc.data.name}
    description={`Misc entry for ${misc.data.name}.`}
    eyebrow="Misc"
    mod={Astro.params.mod ?? misc.id.split("/")[0]}
    tone="tone-plum"
    typeLabel="Misc"
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>
