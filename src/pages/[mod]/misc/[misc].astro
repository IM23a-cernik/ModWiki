---
import { getCollection, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";
import { getModSlugFromId, getRouteEntryParams } from "../../../utils/contentEntry.js";

export async function getStaticPaths() {
    const miscEntries = await getCollection("misc");

    return miscEntries
        .map((misc) => {
            const routeParams = getRouteEntryParams(misc.id, "misc");
            if (!routeParams) {
                return null;
            }

            return {
                params: { mod: routeParams.mod, misc: routeParams.entrySlug },
                props: { misc },
            };
        })
        .filter(Boolean);
}

const { misc } = Astro.props;
const { Content } = await render(misc);
---

<ItemLayout
    title={misc.data.name}
    description={`Misc entry for ${misc.data.name}.`}
    eyebrow="Misc"
    mod={Astro.params.mod ?? getModSlugFromId(misc.id)}
    tone="tone-plum"
    typeLabel="Misc"
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>
