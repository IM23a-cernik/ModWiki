---
import { getCollection, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";

export async function getStaticPaths() {
    const blocks = await getCollection("blocks");

    return blocks
        .map((block) => {
            const [mod, section, blockSlug] = block.id.split("/");

            if (!mod || section !== "blocks" || !blockSlug) {
                return null;
            }

            return {
                params: { mod, block: blockSlug },
                props: { block },
            };
        })
        .filter(Boolean);
}

const { block } = Astro.props;
const { Content } = await render(block);
---

<ItemLayout
    title={block.data.name}
    description={`Block entry for ${block.data.name}.`}
    eyebrow="Block"
    mod={Astro.params.mod ?? block.id.split("/")[0]}
    tone="tone-blue"
    typeLabel="Block"
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>
