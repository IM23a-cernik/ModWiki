---
import { getCollection, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";
import { getModSlugFromId, getRouteEntryParams } from "../../../utils/contentEntry.js";

export async function getStaticPaths() {
    const blocks = await getCollection("blocks");

    return blocks
        .map((block) => {
            const routeParams = getRouteEntryParams(block.id, "blocks");
            if (!routeParams) {
                return null;
            }

            return {
                params: { mod: routeParams.mod, block: routeParams.entrySlug },
                props: { block },
            };
        })
        .filter(Boolean);
}

const { block } = Astro.props;
const { Content } = await render(block);
---

<ItemLayout
    title={block.data.name}
    description={`Block entry for ${block.data.name}.`}
    eyebrow="Block"
    mod={Astro.params.mod ?? getModSlugFromId(block.id)}
    tone="tone-blue"
    typeLabel="Block"
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>
