---
import { getCollection, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";
import { getModSlugFromId, getRouteEntryParams } from "../../../utils/contentEntry.js";

export async function getStaticPaths() {
    const items = await getCollection("items");

    return items
        .map((item) => {
            const routeParams = getRouteEntryParams(item.id, "items");
            if (!routeParams) {
                return null;
            }

            return {
                params: { mod: routeParams.mod, item: routeParams.entrySlug },
                props: { item },
            };
        })
        .filter(Boolean);
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ItemLayout
    title={item.data.name}
    description={`Item entry for ${item.data.name}.`}
    eyebrow="Item"
    mod={Astro.params.mod ?? getModSlugFromId(item.id)}
    tone="tone-gold"
    typeLabel="Item"
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>
