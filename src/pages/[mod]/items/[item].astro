---
import { getCollection, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";

export async function getStaticPaths() {
    const items = await getCollection("items");

    return items
        .map((item) => {
            const [mod, section, itemSlug] = item.id.split("/");

            if (!mod || section !== "items" || !itemSlug) {
                return null;
            }

            return {
                params: { mod, item: itemSlug },
                props: { item },
            };
        })
        .filter(Boolean);
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ItemLayout
    title={item.data.name}
    description={`Item entry for ${item.data.name}.`}
    eyebrow="Item"
    mod={Astro.params.mod ?? item.id.split("/")[0]}
    tone="tone-gold"
    typeLabel="Item"
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>
