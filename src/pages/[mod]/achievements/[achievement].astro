---
import { getCollection, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";

export async function getStaticPaths() {
    const achievements = await getCollection("achievements");

    return achievements
        .map((achievement) => {
            const [mod, section, achievementSlug] = achievement.id.split("/");

            if (!mod || section !== "achievements" || !achievementSlug) {
                return null;
            }

            return {
                params: { mod, achievement: achievementSlug },
                props: { achievement },
            };
        })
        .filter(Boolean);
}

const { achievement } = Astro.props;
const { Content } = await render(achievement);
---

<ItemLayout
    title={achievement.data.name}
    description={`Achievement entry for ${achievement.data.name}.`}
    eyebrow="Achievement"
    mod={Astro.params.mod ?? achievement.id.split("/")[0]}
    tone="tone-burgundy"
    typeLabel="Achievement"
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>
