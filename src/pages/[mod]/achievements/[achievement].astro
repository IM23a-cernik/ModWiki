---
import { getCollection, getEntry, render } from "astro:content";
import ItemLayout from "../../../layouts/ItemLayout.astro";
import { getModSlugFromId, getRouteEntryParams } from "../../../utils/contentEntry.js";
import { getModPresentation } from "../../../utils/styleUtil.ts";

export async function getStaticPaths() {
    const achievements = await getCollection("achievements");

    return achievements
        .map((achievement) => {
            const routeParams = getRouteEntryParams(achievement.id, "achievements");
            if (!routeParams) {
                return null;
            }

            return {
                params: { mod: routeParams.mod, achievement: routeParams.entrySlug },
                props: { achievement },
            };
        })
        .filter(Boolean);
}

const { achievement } = Astro.props;
const { Content } = await render(achievement);
const modSlug = Astro.params.mod ?? getModSlugFromId(achievement.id);
const modEntry = await getEntry("mods", `${modSlug}/mod`);
const { icon: modIcon, themeStyle } = getModPresentation(modEntry);
---

<ItemLayout
        title={achievement.data.name}
        description={`Achievement entry for ${achievement.data.name}.`}
        eyebrow="Achievement"
        mod={modSlug}
        tone="tone-mod"
        typeLabel="Achievement"
        modIcon={modIcon}
        entryIcon={achievement.data.icon}
        themeStyle={themeStyle}
>
    <div class="prose">
        <Content />
    </div>
</ItemLayout>