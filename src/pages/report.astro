---
import Layout from '../layouts/Layout.astro';
import { withBaseUrl } from '../utils/url.js';

const modName = Astro.url.searchParams.get('mod') ?? '';
const modVersion = Astro.url.searchParams.get('version') ?? '';
const apiBase = import.meta.env.PUBLIC_API_BASE;
const reportAction = apiBase ? `${apiBase.replace(/\/$/u, '')}/bug-report` : withBaseUrl('/api/bug-report');
---

<Layout title="Report Issue | ModWiki">
	<main class="page-shell report-page">
		<section class="hero report-hero">
			<div class="hero__content tone-burgundy">
				<h1>Send a bug report or give suggestions.</h1>
				<p class="summary">
					Reports go straight to my Discord so I can fix the issue quickly.
				</p>
			</div>
		</section>

		<form class="section-card report-form tone-burgundy" method="POST" action={reportAction} data-report-form>
			<div class="field-group">
				<label for="modName">Mod name</label>
				<input id="modName" name="modName" value={modName} placeholder="Stalinium" required />
			</div>

			<div class="field-row">
				<div class="field-group">
					<label for="modVersion">Mod version</label>
					<input id="modVersion" name="modVersion" value={modVersion} placeholder="1.0.0" required />
				</div>
				<div class="field-group">
					<label for="modLoader">Mod loader</label>
					<select id="modLoader" name="modLoader" required>
						<option value="">Choose loader</option>
						<option>Fabric</option>
						<option>Forge</option>
						<option>NeoForge</option>
					</select>
				</div>
				<div class="field-group">
					<label for="mcVersion">Minecraft version</label>
					<input id="mcVersion" name="mcVersion" placeholder="1.21.1" required />
				</div>
			</div>

			<div class="field-group">
				<label for="message">What happened?</label>
				<textarea
					id="message"
					name="message"
					rows="6"
					placeholder="Describe the issue, steps to reproduce, and what you expected."
					required
				></textarea>
			</div>

			<div class="field-group">
				<label for="crashLog">Crash log (optional)</label>
				<textarea
					id="crashLog"
					name="crashLog"
					rows="6"
					placeholder="Paste crash log or stack trace here."
				></textarea>
			</div>

			<div class="field-group subtle">
				<label for="contact">Contact (optional)</label>
				<input id="contact" name="contact" placeholder="Discord tag or email" />
			</div>

			<input type="text" name="company" class="honeypot" tabindex="-1" autocomplete="off" />

			<button type="submit" class="primary" data-report-submit>Send report</button>
			<p class="fine-print">
				Reports are routed to Discord. Personal info is optional &mdash; add only what you want shared.
			</p>
		</form>
	</main>

	<div class="report-popup" data-report-popup hidden>
		<div class="report-popup__dialog" role="status" aria-live="polite">
			<p class="report-popup__title" data-report-popup-title>Report sent</p>
			<button type="button" class="report-popup__close" data-report-popup-close>Close</button>
		</div>
	</div>

	<script>
		const form = document.querySelector('[data-report-form]');
		const submitButton = document.querySelector('[data-report-submit]');
		const popup = document.querySelector('[data-report-popup]');
		const popupTitle = document.querySelector('[data-report-popup-title]');
		const popupClose = document.querySelector('[data-report-popup-close]');

		const showPopup = (state, title) => {
			if (
				!(popup instanceof HTMLElement)
				|| !(popupTitle instanceof HTMLElement)
			) {
				return;
			}

			popup.dataset.state = state;
			popupTitle.textContent = title;
			popup.hidden = false;
		};

		if (popup instanceof HTMLElement && popupClose instanceof HTMLButtonElement) {
			popupClose.addEventListener('click', () => {
				popup.hidden = true;
			});

			popup.addEventListener('click', (event) => {
				if (event.target === popup) {
					popup.hidden = true;
				}
			});
		}

		if (form instanceof HTMLFormElement && submitButton instanceof HTMLButtonElement) {
			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				submitButton.disabled = true;
				submitButton.textContent = 'Sending...';

				try {
					const response = await fetch(form.action, {
						method: 'POST',
						body: new FormData(form),
					});

					if (!response.ok) {
						const message = await response.text();
						throw new Error(message || `Request failed with status ${response.status}`);
					}

					form.reset();
					showPopup('success', 'Report sent');
				} catch (error) {
					showPopup(
						'error',
						error instanceof Error ? `Report not sent: ${error.message}` : 'Report not sent'
					);
				} finally {
					submitButton.disabled = false;
					submitButton.textContent = 'Send report';
				}
			});
		}
	</script>
</Layout>
